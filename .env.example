# Tidepop — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git — it is already in .gitignore.

# ── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Klaviyo ──────────────────────────────────────────────────────────────────
# Found in: Klaviyo → Account → Settings → API Keys

KLAVIYO_PRIVATE_KEY=pk_xxxxxxxxxxxxxxxxxxxxx
KLAVIYO_LIST_ID=XXXXXX  # Found in Klaviyo → Lists & Segments → your list → Settings

# ── Internal ─────────────────────────────────────────────────────────────────
# Random secret used to protect the sync-to-klaviyo internal edge function
# Generate with: openssl rand -hex 32

INTERNAL_SECRET=your-random-secret-here
